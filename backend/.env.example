PORT=8000
NODE_ENV=development
MONGODB_URL=replace_with_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CLOUDINARY_NAME=replace_with_cloudinary_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODERATION_MODEL=gemini-3.8-flash
ENABLE_VIDEO_EDUCATIONAL_MODERATION=false
MODERATOR_EMAILS=moderator@example.com
AGENT_PANEL_URL=http://localhost:8100
AGENT_PANEL_INTEGRATION_SECRET=replace_with_the_same_random_secret_in_both_backends_at_least_32_characters
USER_EMAIL=replace_with_gmail_address
USER_PASSWORD=replace_with_gmail_app_password
